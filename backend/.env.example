# ==============================================================================
# CHOLTI MART BACKEND API: ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env on your cPanel server / hosting environment.
# Update the values with your actual cPanel MySQL database credentials.

# Server Port (Passenger / cPanel typically sets PORT automatically)
PORT=5000
NODE_ENV=production

# MySQL Database Configuration (From cPanel -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yourcpaneluser_choltimart
DB_USER=yourcpaneluser_dbuser
DB_PASSWORD=your_secure_mysql_password
DB_CONNECTION_LIMIT=10

# JWT Authentication Secrets
JWT_SECRET=replace_with_a_super_strong_random_secret_string_minimum_32_characters
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS)
# Add your frontend domain(s) separated by comma
CLIENT_ORIGIN=https://choltimart.com,https://www.choltimart.com,http://localhost:3000
