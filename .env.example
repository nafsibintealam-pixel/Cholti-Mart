# ==============================================================================
# CHOLTI MART ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This file documents all environment variables required for Cholti Mart.
# NEVER commit real production secrets, private keys, or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed to Vite frontend bundle)
# ------------------------------------------------------------------------------
# Only variables prefixed with VITE_ are accessible to the browser.
# DO NOT put database passwords, consumer secrets, or private API keys here.

# Runtime Environment: 'development' | 'staging' | 'production'
VITE_APP_ENV=development

# Data Mode: 'true' enables in-browser mock/localStorage drivers (recommended for local dev/preview)
# Set to 'false' in production or staging to require a live backend.
VITE_USE_MOCK_DATA=true

# Custom Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# WordPress Core REST API Base URL (e.g. for CMS pages, media, FAQs)
VITE_WORDPRESS_API_URL=https://example-choltimart-backend.com/wp-json/wp/v2

# WooCommerce REST API Base URL (e.g. for products, categories, orders)
VITE_WOOCOMMERCE_API_URL=https://example-choltimart-backend.com/wp-json/wc/v3

# Authentication API Endpoint
VITE_AUTH_API_URL=http://localhost:3000/api/v1/auth

# Application Host URL (Injected automatically in Cloud Run / AI Studio)
APP_URL=http://localhost:3000

# Gemini AI API Key (Server-side proxy only; injected by platform)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (STRICTLY FORBIDDEN IN FRONTEND SOURCE CODE)
# ------------------------------------------------------------------------------
# The following variables MUST ONLY be configured in the server runtime (.env on server,
# Cloud Run Secret Manager, or cPanel environment variables).
# DO NOT add the VITE_ prefix to any variable in this section.

# --- MySQL / MariaDB Relational Database ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=choltimart_db
# DB_USER=cholti_db_user
# DB_PASSWORD=your_super_strong_database_password_here

# --- WordPress & WooCommerce API Secrets (Server-to-Server Only) ---
# WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Courier Integration Credentials (Server-to-Server Webhooks & APIs) ---
# STEADFAST_API_KEY=your_steadfast_api_key_here
# STEADFAST_SECRET_KEY=your_steadfast_secret_key_here
# PATHAO_CLIENT_ID=your_pathao_client_id_here
# PATHAO_CLIENT_SECRET=your_pathao_client_secret_here
# REDX_API_TOKEN=your_redx_bearer_token_here

# --- Payment Gateway Private Secrets (Server-Side IPN Webhooks & Ledgers) ---
# BKASH_APP_KEY=your_bkash_merchant_app_key
# BKASH_APP_SECRET=your_bkash_merchant_app_secret
# BKASH_USERNAME=your_bkash_merchant_username
# BKASH_PASSWORD=your_bkash_merchant_password
# NAGAD_MERCHANT_ID=your_nagad_merchant_id
# NAGAD_MERCHANT_PRIVATE_KEY=your_nagad_merchant_private_key
# SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
# SSLCOMMERZ_STORE_PASSWD=your_sslcommerz_store_password
# SSLCOMMERZ_IS_SANDBOX=false

# --- JWT Authentication & Cryptographic Session Security ---
# JWT_SECRET=your_256bit_cryptographic_jwt_secret_key_here
# JWT_REFRESH_SECRET=your_256bit_cryptographic_refresh_secret_key_here
# SESSION_SECRET=your_express_or_redis_session_secret_key_here

# --- Transactional Communications (Email / SMS) ---
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
# SMTP_USER=orders@yourdomain.com
# SMTP_PASS=your_strong_smtp_password
# SMS_GATEWAY_API_KEY=your_bangladesh_sms_gateway_api_key
